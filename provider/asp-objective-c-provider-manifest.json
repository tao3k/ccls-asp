{
  "schemaId": "agent.semantic-protocols.hook.provider-manifest",
  "schemaVersion": "1",
  "protocolId": "agent.semantic-protocols.hook",
  "protocolVersion": "1",
  "manifestId": "agent.semantic-protocols.providers.objective-c.ccls-asp",
  "manifestVersion": "v1",
  "languageId": "objective-c",
  "providerId": "ccls-asp",
  "namespace": "agent.semantic-protocols.languages.objective-c.ccls-asp",
  "binary": "ccls-asp",
  "commandPrefixArgs": ["--language", "objective-c"],
  "execution": "external-process",
  "source": {
    "defaultExtensions": [".m", ".mm", ".h"],
    "defaultConfigFiles": ["compile_commands.json", ".ccls", "CMakeLists.txt", "project.pbxproj"],
    "defaultSourceRoots": ["src", "Sources", "include", "tests"],
    "defaultIgnoredPathPrefixes": ["build", "DerivedData"],
    "defaultProjectMarkers": ["compile_commands.json", ".ccls", "CMakeLists.txt", "project.pbxproj"],
    "defaultDependencyMarkers": ["compile_commands.json", "CMakeLists.txt", "project.pbxproj"]
  },
  "searchCapabilities": {
    "semanticFacts": true,
    "dependencyTopology": false,
    "dependencyTopologyMetadata": false
  },
  "policy": {
    "directSourceRead": "block",
    "bulkSourceDump": "block",
    "rawSourceSearch": "block",
    "agentSearchJson": "block"
  },
  "routes": {
    "prime": {"argv": ["ccls-asp", "--language", "objective-c", "search", "prime", "--workspace", "{projectRoot}", "--view", "seeds"]},
    "owner": {"argv": ["ccls-asp", "--language", "objective-c", "search", "owner", "{path}", "--workspace", "{projectRoot}", "--view", "seeds"]},
    "lexical": {"argv": ["ccls-asp", "--language", "objective-c", "search", "lexical", "{query}", "owner", "tests", "--workspace", "{projectRoot}", "--view", "seeds"]},
    "query": {"argv": ["ccls-asp", "--language", "objective-c", "query", "--from-hook", "direct-source-read", "--selector", "{selector}", "{termArgs}", "--workspace", "{projectRoot}", "--view", "seeds"]},
    "ingest": {"argv": ["ccls-asp", "--language", "objective-c", "search", "ingest", "--workspace", "{projectRoot}", "--view", "seeds"], "stdinMode": "pipe-candidates"},
    "checkChanged": {"argv": ["ccls-asp", "--language", "objective-c", "check", "changed", "--workspace", "{projectRoot}"]},
    "guide": {"argv": ["ccls-asp", "--language", "objective-c", "guide", "--workspace", "{projectRoot}"]}
  }
}
